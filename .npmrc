# NPM Registry Configuration
registry=https://registry.npmjs.org/

# Auto-auth token (if needed)
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Package publishing settings
access=public
tag=latest

# Enable strict SSL
strict-ssl=true

# Save exact versions
save-exact=false

# Show fund messages
fund=true

# Legacy peer dependencies for Node 20 compatibility
legacy-peer-deps=true

# Ignore engine warnings
engine-strict=false
